[
 {
  "s": 0.03,
  "e": 2.53,
  "text": "কেউ যদি আপনার সামনে হঠাৎ চুপ করে যায়,"
 },
 {
  "s": 2.94,
  "e": 4.22,
  "text": "ভুলেও এই কাজটা করবেন না।"
 },
 {
  "s": 4.91,
  "e": 6.04,
  "text": "রফিক সাহেব করেছিলেন।"
 },
 {
  "s": 6.49,
  "e": 8.92,
  "text": "আর তার দাম দিয়েছিলেন লাখ লাখ টাকা।"
 },
 {
  "s": 9.53,
  "e": 12.52,
  "text": "গাজীপুরে রফিক সাহেবের ছোট একটা গার্মেন্টস কারখানা।"
 },
 {
  "s": 12.92,
  "e": 14.53,
  "text": "বহু বছরের চেষ্টার পর প্রথমবার"
 },
 {
  "s": 14.68,
  "e": 16.81,
  "text": "ইউরোপের এক বড় বায়ার এসেছেন।"
 },
 {
  "s": 17.58,
  "e": 20.06,
  "text": "অর্ডারটা পেলে কারখানার চেহারাই বদলে যাবে।"
 },
 {
  "s": 20.46,
  "e": 22.16,
  "text": "মিটিংয়ে রফিক সাহেব দাম বললেন।"
 },
 {
  "s": 22.63,
  "e": 23.91,
  "text": "প্রতি পিস চার ডলার।"
 },
 {
  "s": 24.42,
  "e": 25.58,
  "text": "বায়ার কিছু বললেন না।"
 },
 {
  "s": 26.02,
  "e": 27.68,
  "text": "শুধু ফাইলের দিকে তাকিয়ে রইলেন।"
 },
 {
  "s": 28.15,
  "e": 30.17,
  "text": "দশ সেকেন্ড। পনেরো সেকেন্ড।"
 },
 {
  "s": 30.59,
  "e": 32.31,
  "text": "রফিক সাহেব আর থাকতে পারলেন না।"
 },
 {
  "s": 32.77,
  "e": 35.96,
  "text": "\"মানে... অর্ডার বড় হলে\nসাড়ে তিন ডলারেও করা যায়।\""
 },
 {
  "s": 36.4,
  "e": 37.5,
  "text": "বায়ার তখনও চুপ।"
 },
 {
  "s": 38.02,
  "e": 40.69,
  "text": "\"আসলে আমাদের কাপড়ের খরচ একটু কম,"
 },
 {
  "s": 40.83,
  "e": 42.95,
  "text": "তাই... তিন ডলার বিশ সেন্টেও পারব।\""
 },
 {
  "s": 43.28,
  "e": 44.56,
  "text": "বায়ার এবার মাথা নাড়লেন।"
 },
 {
  "s": 45.07,
  "e": 45.79,
  "text": "চুক্তি হয়ে গেল।"
 },
 {
  "s": 46.28,
  "e": 47.8,
  "text": "মাসখানেক পর এক ডিনারে"
 },
 {
  "s": 47.95,
  "e": 50.76,
  "text": "সেই বায়ার হাসতে হাসতে বললেন,"
 },
 {
  "s": 51.1,
  "e": 53.86,
  "text": "\"আপনার প্রথম দামটাই\nআমাদের বাজেটের মধ্যে ছিল।"
 },
 {
  "s": 54.14,
  "e": 56.12,
  "text": "আমি তো শুধু মনে মনে হিসাব মেলাচ্ছিলাম।\""
 },
 {
  "s": 56.58,
  "e": 58.06,
  "text": "রফিক সাহেবকে কেউ ঠকায়নি।"
 },
 {
  "s": 58.49,
  "e": 60.11,
  "text": "তিনি নিজেই নিজেকে ঠকিয়েছেন।"
 },
 {
  "s": 60.46,
  "e": 62.52,
  "text": "শুধু নীরবতা সহ্য করতে না পেরে।"
 },
 {
  "s": 62.98,
  "e": 65.01,
  "text": "মানুষ চুপ থাকাকে ভয় পায়।"
 },
 {
  "s": 65.35,
  "e": 67.82,
  "text": "মনে হয়, অন্যজন বিরক্ত, রাজি না।"
 },
 {
  "s": 68.16,
  "e": 70.93,
  "text": "তাই আমরা ফাঁকা জায়গাটা কথা দিয়ে ভরাতে থাকি।"
 },
 {
  "s": 71.22,
  "e": 75.05,
  "text": "আর যত বেশি বলি,\nতত বেশি নিজের দুর্বলতা দেখিয়ে ফেলি।"
 },
 {
  "s": 75.42,
  "e": 79.88,
  "text": "Robert Greene তাঁর The 48 Laws of Power\nবইয়ে এটাকেই বলেছেন,"
 },
 {
  "s": 80.25,
  "e": 83.33,
  "text": "Law 4: Always Say Less Than Necessary."
 },
 {
  "s": 83.7,
  "e": 85.9,
  "text": "প্রয়োজনের চেয়ে সবসময় কম বলো।"
 },
 {
  "s": 86.24,
  "e": 89.35,
  "text": "যে কম বলে,\nতাকে মানুষ পুরোপুরি বুঝতে পারে না।"
 },
 {
  "s": 89.66,
  "e": 93.34,
  "text": "আর যাকে বোঝা যায় না,\nতার সামনে মানুষ নিজেই নিজেকে খুলে দেয়।"
 },
 {
  "s": 93.69,
  "e": 96.4,
  "text": "তাই পরের বার কেউ আপনার সামনে চুপ করে গেলে,"
 },
 {
  "s": 96.6,
  "e": 98.87,
  "text": "তাড়াহুড়ো করে সেই নীরবতা ভাঙতে যাবেন না।"
 },
 {
  "s": 99.2,
  "e": 99.72,
  "text": "চুপ থাকুন।"
 },
 {
  "s": 100.05,
  "e": 101.81,
  "text": "নীরবতাটা তাকেই ভাঙতে দিন।"
 },
 {
  "s": 102.25,
  "e": 104.95,
  "text": "আপনি কি কখনো বেশি কথা বলে\nনিজের ক্ষতি করেছেন?"
 },
 {
  "s": 105.29,
  "e": 105.91,
  "text": "কমেন্টে লিখুন।"
 },
 {
  "s": 106.21,
  "e": 108.34,
  "text": "আর এমন গল্প পেতে ফলো করে রাখুন।"
 }
