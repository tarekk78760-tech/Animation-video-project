[
 {
  "s": 0.21,
  "e": 1.8,
  "text": "সাকিবের কোনো শত্রু ছিল না।"
 },
 {
  "s": 2.4,
  "e": 4.76,
  "text": "তবু তার স্বপ্ন শেষ করে দিল তার রুমমেট,"
 },
 {
  "s": 5.18,
  "e": 6.6,
  "text": "একটাও খারাপ কাজ না করে।"
 },
 {
  "s": 7.22,
  "e": 8.67,
  "text": "ঢাকার এক মেসে থাকে সাকিব।"
 },
 {
  "s": 9.2,
  "e": 10.98,
  "text": "চাকরির জন্য দিনরাত পড়ে।"
 },
 {
  "s": 11.57,
  "e": 13.16,
  "text": "রুমমেট মিঠু ঠিক উল্টো।"
 },
 {
  "s": 13.64,
  "e": 15.07,
  "text": "সারাদিন শুধু অভিযোগ।"
 },
 {
  "s": 15.61,
  "e": 16.65,
  "text": "\"এই দেশে কিছু হবে না।\""
 },
 {
  "s": 17.06,
  "e": 18.28,
  "text": "\"সব মামা-খালুর খেলা।\""
 },
 {
  "s": 18.91,
  "e": 20.68,
  "text": "সাকিব ভাবল, ওকে বদলে দেবে।"
 },
 {
  "s": 21.22,
  "e": 24.02,
  "text": "কিন্তু ছয় মাসে সাকিবের পড়া কমতে লাগল।"
 },
 {
  "s": 24.62,
  "e": 27.0,
  "text": "আর এক বছর পর তার মুখেও একই কথা,"
 },
 {
  "s": 27.53,
  "e": 28.25,
  "text": "\"পড়ে কী হবে?\""
 },
 {
  "s": 28.81,
  "e": 34.22,
  "text": "Robert Greene তাঁর The 48 Laws of Power\nবইয়ে এটাকেই বলেছেন,"
 },
 {
  "s": 34.76,
  "e": 37.93,
  "text": "Law 10: Infection:\nAvoid the Unhappy and Unlucky."
 },
 {
  "s": 38.43,
  "e": 40.15,
  "text": "হতাশা সর্দির মতো ছড়ায়।"
 },
 {
  "s": 40.7,
  "e": 43.21,
  "text": "কখন যে আপনাকেও ধরে ফেলে,\nটেরও পাবেন না।"
 },
 {
  "s": 43.57,
  "e": 44.73,
  "text": "মানুষের পাশে থাকুন,"
 },
 {
  "s": 45.23,
  "e": 48.22,
  "text": "কিন্তু তার হতাশাকে\nনিজের ভেতরে জায়গা দেবেন না।"
 },
 {
  "s": 48.6,
  "e": 50.31,
  "text": "আপনার আশেপাশে কি এমন কেউ আছে?"
 },
 {
  "s": 50.78,
  "e": 52.8,
  "text": "কমেন্টে লিখুন। আর ফলো করে রাখুন।"
 }
]